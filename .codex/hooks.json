{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '## In-progress issues' && gh issue list -l status:in-progress --json number,title --jq '.[] | \"#\\(.number) \\(.title)\"' 2>/dev/null | head -20"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/hooks/validate-comment-budget.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
