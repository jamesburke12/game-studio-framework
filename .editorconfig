# Stops editors reintroducing CRLF after .gitattributes normalises it.
# .gitattributes governs what git stores; this governs what editors write.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false   # two trailing spaces are a hard line break

[*.{json,yaml,yml}]
indent_size = 2

[*.py]
indent_size = 4

[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.sh]
end_of_line = lf

[*.{png,jpg,jpeg,gif,wav,mp3,ogg,fbx,psd,aseprite,ase}]
insert_final_newline = false
trim_trailing_whitespace = false
